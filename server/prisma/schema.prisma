generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Campaign {
  id                String   @id
  farmer            String
  title             String   @default("")
  description       String   @default("")
  targetAmount      BigInt?
  tokenAddress      String?
  deadline          BigInt?
  status            String   @default("Active")
  totalFunded       BigInt   @default(0)
  escrowContract    String   @default("")
  trancheCount      Int?
  harvestOutcome    String?
  harvestReportedAt BigInt?
  refundable        BigInt   @default(0)
  returnable        BigInt   @default(0)
  createdAt         BigInt
  updatedAt         DateTime @default(now()) @updatedAt

  investments  Investment[]
  orders       Order[]
  transactions Transaction[]
  disputes     Dispute[]
  tranches     Tranche[]
}

model Investment {
  id         String   @id
  campaignId String
  investor   String
  amount     BigInt
  txHash     String?
  timestamp  BigInt?
  createdAt  DateTime @default(now())

  campaign   Campaign @relation(fields: [campaignId], references: [id])
  user       User     @relation(fields: [investor], references: [address])
}

model Order {
  id         String   @id
  campaignId String?
  buyer      String
  amount     BigInt?
  status     String   @default("Pending")
  confirmedAt BigInt?
  txHash     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
}

model User {
  address     String   @id
  name        String?
  firstSeenAt BigInt?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  investments  Investment[]
  transactions Transaction[]
}

model Transaction {
  id         String   @id
  type       String
  campaignId String?
  userId     String?
  amount     BigInt?
  txHash     String?
  status     String   @default("Pending")
  timestamp  BigInt?
  data       String   @default("{}")
  createdAt  DateTime @default(now())

  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  user       User?     @relation(fields: [userId], references: [address])
}

model Dispute {
  id                    String   @id
  campaignId            String
  opener                String
  reason                String
  status                String   @default("Open")
  resolution            String?
  admin                 String?
  payoutToFarmer        BigInt?
  refundableToInvestors BigInt?
  openedAt              BigInt
  resolvedAt            BigInt?
  ledgerSequence        Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Tranche {
  id         String   @id
  campaignId String
  recipient  String
  amount     BigInt
  releasedAt BigInt
  txHash     String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model IndexerCursor {
  contractId          String   @id
  lastProcessedLedger Int
  updatedAt           DateTime @default(now()) @updatedAt
}
