# Application
NODE_ENV=development
PORT=3000

# Logging
# One of: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrocylo_pip?schema=public
# Set to false for unit/e2e tests that do not start Postgres.
DATABASE_CONNECT_ON_STARTUP=true

# Soroban RPC Configuration
INDEXER_ENABLED=true
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
PRODUCTION_ESCROW_CONTRACT_ID=
ESCROW_CONTRACT_ID=
EVENT_POLL_INTERVAL_MS=5000
EVENT_RETENTION_DAYS=7
